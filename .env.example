# Copy to .env. Only needed for live mode (FEED=nrod) and `npm run data:corpus`.
# Register at https://publicdatafeeds.networkrail.co.uk and enable the
# TRAIN_MVT_ALL_TOC feed for your account.
NROD_USERNAME=you@example.com
NROD_PASSWORD=

# demo (default) or nrod. docker compose always uses nrod.
FEED=demo
PORT=3000
# Live mode keeps the timetable, CORPUS and the trains on the map here
# (default ./state; /app/state in Docker).
# STATE_DIR=state
# Host port for docker compose (default 3000).
# HOST_PORT=3000

# TfL lines (Underground, Overground, Elizabeth line, DLR): on by default,
# TFL=off to hide them.
# An app key (https://api-portal.tfl.gov.uk) raises the rate limit; optional.
# TFL=on
# TFL_APP_KEY=

# Optional overrides for the NROD broker
# NROD_HOST=publicdatafeeds.networkrail.co.uk
# NROD_PORT=61618
# NROD_TLS=false
# NROD_TOPIC=TRAIN_MVT_ALL_TOC
